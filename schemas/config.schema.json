{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kapibara.dev/schemas/config.schema.json",
  "title": "Kapibara configuration",
  "description": "Project or global Kapibara configuration. Unknown keys are allowed.",
  "type": "object",
  "properties": {
    "profile": {
      "type": "string",
      "enum": ["balanced", "developer", "strict", "custom"],
      "default": "balanced"
    },
    "auditLog": {
      "type": "boolean",
      "default": false,
      "description": "Write sanitized JSONL audit records under .kapibara/logs/."
    },
    "failMode": {
      "type": "string",
      "enum": ["risk_based", "closed", "open"],
      "default": "risk_based",
      "description": "Behavior when rules cannot be loaded."
    },
    "auditRetentionDays": {
      "type": "integer",
      "minimum": 1,
      "maximum": 365,
      "default": 7
    }
  },
  "additionalProperties": true
}
